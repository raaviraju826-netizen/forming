# KisanAI Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── Database (default: SQLite — no installation required) ───────────────────
DATABASE_URL=sqlite+aiosqlite:///./kisanai.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./kisanai.db

# ─── JWT Auth ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── AI / LLM (optional — chatbot uses fallback if not set) ──────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Market Prices API (optional — register at data.gov.in) ──────────────────
AGMARKNET_API_KEY=

# ─── App Settings ────────────────────────────────────────────────────────────
DEBUG=True
ENVIRONMENT=development
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
CONFIDENCE_THRESHOLD=0.55
